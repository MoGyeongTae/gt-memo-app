{
  "expo": {
    "name": "gt-memo-app",
    "slug": "gt-memo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gtmemoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mogyeongtae.gtmemoapp",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.mogyeongtae.gtmemoapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "MemoWidget",
              "displayName": "메모",
              "description": "앱에서 고른 메모를 포스트잇으로 보여줘요.",
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "minWidth": 250,
                "minHeight": 110,
                "resizeMode": "both"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d061c874-42b1-4101-a186-c4f0f05d921e"
      }
    }
  }
}
